# Copy to ROOT .env for Docker Compose; generate secrets with init-env.ps1.
API_HOST=127.0.0.1
API_PORT=8000
POSTGRES_PASSWORD=
REDIS_PASSWORD=
LOGIN_SIGNING_KEY=
TASK_TOKEN_SIGNING_KEY=
TOOL_SERVICE_KEY=
DEMO_DISPATCHER_PASSWORD=
DEMO_DRIVER_PASSWORD=
# Explicit local rule simulator. Use deepseek for real API requests.
AGENT_MODE=local
SIMULATION_TIME=2026-10-26T10:00:00+08:00
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Set to the model enabled for your account. No API call is made in local mode.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# JSON array of explicit browser origins (scheme + host + optional port, no trailing slash).
CORS_ALLOW_ORIGINS=[]
# Private Web Service key, never sent to the frontend. No random coordinates are seeded.
AMAP_WEB_SERVICE_KEY=
AMAP_REQUEST_TIMEOUT_SECONDS=10
AMAP_CACHE_TTL_SECONDS=300
AMAP_TOTAL_BUDGET_SECONDS=60
# Local uv commands also need DATABASE_URL and REDIS_URL. Keep passwords private.
