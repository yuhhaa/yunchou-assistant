# Copy to .env.amap-server.local. Node loads it only for the loopback Vite dev server.
AMAP_SECURITY_JSCODE=replace_with_new_server_only_security_code
# Or use the team's HTTPS security proxy, without a path or embedded credentials.
# AMAP_PROXY_TARGET=https://backend.example.com
# Optional: road projection for simulated delivery routes in local Vite previews.
# AMAP_WEB_SERVICE_KEY=replace_with_server_only_web_service_key
