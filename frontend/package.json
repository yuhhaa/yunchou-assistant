{
  "name": "yunchou-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "playwright test",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "format": "prettier --write src tests vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@types/node": "^24.19.2",
    "lucide-vue-next": "^0.468.0",
    "maplibre-gl": "^6.16.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vue-tsc": "^3.1.1"
  }
}
