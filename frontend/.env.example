API_PROXY_TARGET=http://127.0.0.1:8000
# Browser-public Web JS API Key. Configure allowed origins in the AMap console.
VITE_AMAP_JS_KEY=replace_with_new_web_js_key
VITE_AMAP_SERVICE_HOST=/_AMapService
# Server-only development settings belong in .env.amap-server.local.
# See .env.amap-server.example; never put a security credential in VITE_*.
