# Copy to deploy/huaweicloud/.env on the deployment host. Never commit real values.
# Full credentials must be URL-encoded. Use the actual RDS/DCS private addresses.
DATABASE_URL=
REDIS_URL=
LOGIN_SIGNING_KEY=
TASK_TOKEN_SIGNING_KEY=
TOOL_SERVICE_KEY=
AGENT_MODE=local
AUTO_APPROVAL_ENABLED=false
AUTO_APPROVAL_MAX_CHANGED_ORDERS=2
AUTO_APPROVAL_MAX_DELAY_MINUTES=30
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
AMAP_WEB_SERVICE_KEY=
AMAP_REQUEST_TIMEOUT_SECONDS=10
AMAP_CACHE_TTL_SECONDS=300
AMAP_TOTAL_BUDGET_SECONDS=60
CORS_ALLOW_ORIGINS=[]
CLOCK_MODE=SIMULATION
SIMULATION_TIME=2026-10-26T10:00:00+08:00
API_HOST=127.0.0.1
API_PORT=8000
# Only needed for explicitly importing a new demonstration tenant.
DEMO_DISPATCHER_PASSWORD=
DEMO_DRIVER_PASSWORD=
